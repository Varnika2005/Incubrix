# =============================================================================
# ClipPilot AI — IncuBrix Environment Configuration
# =============================================================================

# Server & Network Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Security, JWT & HMAC Webhook Secrets
# (In production, replace with cryptographically secure random 32+ character strings)
SECRET_KEY=clippilot_secure_local_dev_secret_key_min_32_characters_2026
CALLBACK_SECRET=clippilot_secure_callback_hmac_secret_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_DAYS=30

# Database Configuration
DATABASE_URL=sqlite:///storage/clippilot.db

# Object Storage / S3 / MinIO
ENABLE_S3_STORAGE=false
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET_NAME=clippilot
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_URL_PREFIX=

# Media Processing Limits & Validation
MAX_UPLOAD_SIZE_MB=250
MAX_URL_DOWNLOAD_SIZE_MB=250
MAX_DURATION_SECONDS=600

# Timeouts & Idempotency Retention
URL_FETCH_TIMEOUT_SECONDS=30.0
PROCESSING_TIMEOUT_SECONDS=600.0
IDEMPOTENCY_EXPIRY_HOURS=24

# FFmpeg Encoding Defaults
DEFAULT_VIDEO_CODEC=libx264
DEFAULT_AUDIO_CODEC=aac
DEFAULT_PRESET=fast
DEFAULT_CRF=22

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional External AI Keys (Deterministic offline engine active by default)
GEMINI_API_KEY=
OPENAI_API_KEY=
