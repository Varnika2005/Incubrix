# ClipPilot AI — Environment Configuration Example

# Server Settings
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api

# FFmpeg Executable Overrides (Optional — auto-discovered if omitted)
FFMPEG_PATH=
FFPROBE_PATH=

# Security & Media Limits
MAX_UPLOAD_SIZE_MB=250
MAX_DURATION_SECONDS=600

# Optional LLM Integration (Zero paid API keys needed; ClipPilot uses robust local deterministic parsing by default)
GEMINI_API_KEY=
OPENAI_API_KEY=
