# ClipPilot AI — Environment Configuration Example

# Server Settings
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api

# FFmpeg Executable Overrides (Optional — auto-discovered if omitted)
FFMPEG_PATH=
FFPROBE_PATH=

# Security, Auth & Media Limits
SECRET_KEY=your-cryptographically-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_MB=250
MAX_DURATION_SECONDS=600

# Optional LLM Integration (Zero paid API keys needed; ClipPilot uses robust local deterministic parsing by default)
GEMINI_API_KEY=
OPENAI_API_KEY=
